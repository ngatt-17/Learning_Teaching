# Browser-side API bases. The defaults go through the Vite proxy (vite.config.ts),
# so local development needs no CORS setup. Override only when the APIs are served
# from another origin in staging.
# VITE_PLATFORM_API_URL=/api/platform
# VITE_AI_API_URL=/api/ai

# Proxy targets used by `npm run dev` / `npm run preview` (read by vite.config.ts, not the browser)
# PLATFORM_API_URL=http://localhost:8000
# AI_API_URL=http://localhost:8001
