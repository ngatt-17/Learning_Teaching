# ── Generic LLM API Configuration (OpenAI-compatible standard) ───────────────
# API Key của nhà cung cấp LLM (OpenAI, DeepSeek, Azure, hoặc bất kỳ OpenAI-compatible proxy nào)
LLM_API_KEY=your-api-key-here

# Base URL của nhà cung cấp LLM (ví dụ: https://api.openai.com/v1 hoặc proxy endpoint)
LLM_BASE_URL=https://api.your-provider.com/v1

# Tên Model (ví dụ: gpt-4o-mini hoặc model tương đương)
LLM_MODEL=your-model-name-here

# Port của AI service
AI_SERVICE_PORT=8001
