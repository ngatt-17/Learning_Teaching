# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cecs_app:0000@localhost:5432/cecs_ai_hub

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256

# ── Server ───────────────────────────────────────────────────────────────
PORT=8000

# ── OTP policy ───────────────────────────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Throttle between two code requests for the same email (real email only)
OTP_RESEND_COOLDOWN_SECONDS=60
# Dev backdoor: code 000000 always verifies. MUST be false in staging/production.
ALLOW_DEV_MASTER_OTP=true

# ── Email delivery ───────────────────────────────────────────────────────
# console  = print the code to the server log (default, no account needed)
# smtp     = any SMTP server, including AWS SES SMTP and Gmail App Password
# sendgrid = SendGrid HTTP API v3
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@vinuni.edu.vn
EMAIL_FROM_NAME=CECS AI Learning Hub

# --- Option A: SendGrid (HTTP API, works behind blocked SMTP ports) ------
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx

# --- Option B: AWS SES (SMTP interface) ---------------------------------
# EMAIL_PROVIDER=smtp
# SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIAxxxxxxxxxxxxxxxx          # SES SMTP username, not the AWS access key
# SMTP_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx  # SES SMTP password

# --- Option C: Gmail App Password (quick demo only) ---------------------
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.account@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
