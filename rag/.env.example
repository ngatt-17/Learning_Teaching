# ==============================================================================
# CECS AI Learning Hub — AI Service Environment Configuration
# Sao chép file này thành `rag/.env` và điền API Key của bạn để test RAG & Quiz.
# LƯU Ý: File .env đã được cấu hình trong .gitignore, KHÔNG BAO GIỜ bị commit lên GitHub.
# ==============================================================================

# ── CẤU HÌNH TIÊU CHUẨN (Generic OpenAI-compatible standard) ─────────────────
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://api.your-provider.com/v1
# LLM_MODEL=your-model-name-here

# --- LỰA CHỌN 1: OpenAI (Khuyên dùng - Ổn định nhất) ---
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# MODEL_NAME=gpt-4o-mini

# --- LỰA CHỌN 2: Google Gemini (Miễn phí qua OpenAI-compatible API) ---
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
# MODEL_NAME=gemini-1.5-flash

# --- LỰA CHỌN 3: DeepSeek (Trực tiếp từ api.deepseek.com) ---
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# MODEL_NAME=deepseek-chat

# --- LỰA CHỌN 4: xKiro (Hỗ trợ DeepSeek free tier) ---
# XKIRO_API_KEY=sk-xt-xxxxxxxxxxxxxxxxxxxxxxxx
# MODEL_NAME=deepseek/deepseek-v4.1-flash:free

# --- TÙY BIẾN KHÁC (Custom Base URL nếu dùng Groq, OpenRouter, v.v.) ---
# AI_API_KEY=your-api-key
# AI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# Cổng dịch vụ FastAPI
AI_SERVICE_PORT=8001

# ── TÍCH HỢP PLATFORM (bắt buộc) ─────────────────────────────────────────────
# AI service không kết nối DB. Nó xác thực JWT của Platform bằng JWT_SECRET dùng chung
# và đọc học liệu đã duyệt qua Platform API bằng chính token của người gọi.
PLATFORM_API_URL=http://localhost:8000
# PHẢI giống hệt JWT_SECRET trong platform/backend/.env
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256

